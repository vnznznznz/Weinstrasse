{# Begleittext zum Lieferschein (deutsch oder englisch je Empfänger: sprache = "de" | "en";
   empfaenger_rolle = "lieferant" | "kunde"). Kontext: anrede, nummer, kunde, lieferant, kundenbestellnummer,
   liefertag, hinweis, gruss, signatur #}
<p>{{ anrede }}</p>
{% if sprache == "en" %}
<p>please find attached the delivery note{% if nummer %} <b>{{ nummer }}</b>{% endif %} for <b>{{ kunde }}</b>{% if lieferant and empfaenger_rolle != "lieferant" %} (goods from {{ lieferant }}){% endif %}{% if liefertag %}, delivery due on {{ liefertag | datum_de }}{% endif %}.
{% if empfaenger_rolle == "lieferant" %}
Kindly hand it over to the carrier together with the shipment.
{% else %}
Kindly check the goods against it on receipt and let us know if anything differs.
{% endif %}
</p>
{% else %}
<p>Anbei erhalten Sie den Lieferschein{% if nummer %} <b>{{ nummer }}</b>{% endif %} für <b>{{ kunde }}</b>{% if kundenbestellnummer %} (Bestellung {{ kundenbestellnummer }}){% endif %}{% if liefertag %}, Lieferung am {{ liefertag | datum_de }}{% endif %}.
{% if empfaenger_rolle == "lieferant" %}
Bitte geben Sie ihn der Spedition mit der Sendung mit.
{% else %}
Bitte gleichen Sie die Ware beim Eingang damit ab und melden Sie sich kurz, falls etwas abweicht.
{% endif %}
</p>
{% endif %}
{% if hinweis %}
<p>{{ hinweis | nl2br }}</p>
{% endif %}
<p>{{ gruss }}</p>
{{ signatur }}
